
<% layout("/layouts/bolierplate") %>


 <div class="col-6 offset-2">
    <h1>SignUp For NepalAnubhav</h1>
<form method="post" action="/signup" class="needs-validation" novalidate>
 <div class="mb-3">
            
    <label for="username" class="form-label">Username</label>
     <input type="text" id="username" name="username" placeholder="Enter a username" class="form-control"  required>
 </div>



 <div class="mb-3">
            
    <label for="email" class="form-label">Email</label>
     <input type="text" id="email" name="email" placeholder="Enter email" class="form-control"  required>
 </div>




 <div class="mb-3">
            
    <label for="password" class="form-label">Pasword</label>
     <input type="password" id="password" name="password" placeholder="Enter a Password" class="form-control"  required>
 </div>


 <button class="btn btn-dark">SingUp</button>
</form>

 </div>
