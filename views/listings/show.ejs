


<% layout("/layouts/bolierplate")%>


<script>
  const mapToken= "<%=process.env.MAP_TOKEN %>"
  const listing= <%- JSON.stringify(listing)%>
</script>


 <div class="col-8 offset-3 mt-1 ">
    
    <h3><%=listing.title%> </h3>


   <div class="card off-set-3 col-12 listing-card">
  <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_img">
  <div class="card-body">
    <p class="card-text"><i>Owned By: <%=listing.owner.username%></i></p>

  <p class="card-text"><b><%=listing.title%></b></p> 
   <p class="card-text"><%=listing.description%></p>  
       
     <p class="text"> &#8377;Price: <%=listing.price.toLocaleString("en-IN")%></p> 
      <p class="text"><%=listing.location%></p> 
      <p class="text"><%=listing.country%></p>  
   
  </div>
</div>




 <%if(currentUser && currentUser._id.equals(listing.owner._id)) { %>   
<div class="btns">
 <form method="get" action="/listing/<%=listing.id%>/edit">
      <button class="btn btn-dark">Edit</button>


     </form>


     
     <form  method="POST" action="/listing/<%=listing.id%>?_method=DELETE">
      <button class=" btn btn-danger">Delete</button>

     </form>



</div>
   <%}%>    





   

  






<div class="mt-5 col-12 mb-3">

<hr>


 <%if(currentUser){%>



<h3 class="mt-3 col-12  offset-3">Reviews and Rating</h3> 


<form method="post" action="/listing/<%=listing.id%>/reviews" novalidate class="needs-validation">

<!-- 
  <div class="mb-3 mt-3">

  <label for="rating" class="form-label col-8">Rating</label>

<input type="range" class="form-range" min="0" max="5" id="rating" name="review[rating]">
  </div>   -->




  <div class="mb-3 mt-3">
        
    <label for="rating" class="form-label col-8">Rating</label>
  <fieldset class="starability-slot">

 
    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />

  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>




     <div >
     <label for="comment" class="form-label"></label>
      <textarea type="text" name="review[comment]" placeholder="Enter a comment" class="form-control" required id="comment" rows="5" cols="45" ></textarea>
      <div class="invalid-feedback"> Add valid Comment</div>
      
      </div>

     

      <button class="btn btn-outline-dark mb-3 mt-3">Submit</button>


</form>

<%}%>
<hr>


<%if(listing.reviews.length>0){%>
<h4>All Reviews</h4>



  <div class="row" > 
<% for(let review of listing.reviews){%>

  <div class="col-6 mb-3">
 <div class="card">

   <div class="card-body text-start">
    <h5 class="card-title">@<%= review.author.username %></h5>
      <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
    <p class="card-text"><%=review.comment%></p>
   


     <form method="post" action="/listing/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
      <button class="btn btn-dark mb-2">delete</button>
    </form> 
   </div>

 </div>

  
</div>
<%}%>
 </div>
<%}%>


</div>




<div class="col-8 offset-3 mb-3">
 <h3>Where you'll be</h3>


 <div id="map"></div>

</div> 


  </div>


  

<script src="/js/map.js"></script>


